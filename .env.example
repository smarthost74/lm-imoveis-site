# URL do feed Carga da ImobiBrasil, contém token de acesso — tratar como segredo.
# Nunca commitar o valor real. Configurar no painel "Setup Node.js App" do cPanel em produção.
FEED_CARGA_URL=

# Destino dos leads do formulário de contato.
LEADS_EMAIL_TO=leads@lobatoemoraesimoveis.com.br

# Remetente autenticado do próprio domínio (precisa ser uma conta de e-mail
# real do cPanel, com o SMTP correspondente abaixo).
LEADS_EMAIL_FROM=

# Credenciais SMTP da conta de e-mail acima (normalmente mail.seudominio.com.br,
# porta 587 com STARTTLS ou 465 com SSL) — sem isso configurado, /api/leads
# recebe o lead mas não envia e-mail (loga e retorna erro, não finge sucesso).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# GA4 (formato G-XXXXXXXXXX, em Admin > Fluxos de dados no GA4)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Ads (formato AW-XXXXXXXXX, em Ferramentas > Acesso e segurança da
# conta > ID de conversão, ou na tag de conversão gerada pela campanha).
# Só a tag base (remarketing/pageview) — rastrear uma conversão específica
# precisa também do "rótulo" que o Google Ads gera por ação, ainda não
# configurado no código (ver CLAUDE.md).
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Meta/Facebook Pixel (formato numérico, em Gerenciador de Eventos do
# Meta Business Suite)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# WhatsApp da imobiliária (fallback único da v1 — ver docs/feed-analysis.md item 6)
NEXT_PUBLIC_WHATSAPP_IMOBILIARIA=5512981660001

# Base para URLs absolutas (mensagens de WhatsApp, JSON-LD, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.lobatoemoraesimoveis.com.br
